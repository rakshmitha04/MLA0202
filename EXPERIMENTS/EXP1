      "source": [
        "# FIND-S Algorithm - Google Colab\n",
        "\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Step 1: Create the sample dataset\n",
        "data = {\n",
        "    \"Sky\": [\"Sunny\", \"Sunny\", \"Rainy\", \"Sunny\"],\n",
        "    \"AirTemp\": [\"Warm\", \"Warm\", \"Cold\", \"Warm\"],\n",
        "    \"Humidity\": [\"Normal\", \"High\", \"High\", \"High\"],\n",
        "    \"Wind\": [\"Strong\", \"Strong\", \"Strong\", \"Strong\"],\n",
        "    \"Water\": [\"Warm\", \"Warm\", \"Warm\", \"Cool\"],\n",
        "    \"Forecast\": [\"Same\", \"Same\", \"Change\", \"Change\"],\n",
        "    \"EnjoySport\": [\"Yes\", \"Yes\", \"No\", \"Yes\"]\n",
        "}\n",
        "\n",
        "df = pd.DataFrame(data)\n",
        "\n",
        "print(\"Training Dataset:\")\n",
        "display(df)\n",
        "\n",
        "# Step 2: Implement FIND-S\n",
        "attributes = list(df.columns[:-1])\n",
        "target = \"EnjoySport\"\n",
        "\n",
        "hypothesis = [\"Ø\"] * len(attributes)\n",
        "history = [hypothesis.copy()]\n",
        "\n",
        "print(\"\\nInitial Hypothesis:\", hypothesis)\n",
        "\n",
        "for index, row in df.iterrows():\n",
        "    if row[target] == \"Yes\":\n",
        "        for i, attribute in enumerate(attributes):\n",
        "            if hypothesis[i] == \"Ø\":\n",
        "                hypothesis[i] = row[attribute]\n",
        "            elif hypothesis[i] != row[attribute]:\n",
        "                hypothesis[i] = \"?\"\n",
        "\n",
        "    history.append(hypothesis.copy())\n",
        "\n",
        "    print(f\"Example {index + 1}: {row[target]}\")\n",
        "    print(\"Hypothesis:\", hypothesis)\n",
        "\n",
        "# Step 3: Display final hypothesis\n",
        "print(\"\\nFinal Most Specific Hypothesis:\")\n",
        "print(dict(zip(attributes, hypothesis)))\n",
        "\n",
        "# Step 4: Visualize hypothesis changes\n",
        "history_df = pd.DataFrame(history, columns=attributes)\n",
        "history_df.index = [\"Initial\"] + [\n",
        "    f\"Example {i}\" for i in range(1, len(df) + 1)\n",
        "]\n",
        "\n",
        "print(\"\\nHypothesis Learning History:\")\n",
        "display(history_df)\n",
        "\n",
        "# Convert hypothesis values to numerical values for plotting\n",
        "mapping = {\"Ø\": 0, \"?\": 2}\n",
        "encoded = history_df.replace(mapping)\n",
        "\n",
        "for column in encoded.columns:\n",
        "    encoded[column] = encoded[column].map(\n",
        "        lambda x: 1 if x == \"Sunny\" or x == \"Warm\"\n",
        "        or x == \"Normal\" or x == \"Strong\"\n",
        "        or x == \"Same\" else x\n",
        "    )\n",
        "\n",
        "encoded = encoded.apply(\n",
        "    lambda col: col.map(\n",
        "        lambda x: x if isinstance(x, (int, float)) else 1\n",
        "    )\n",
        ")\n",
        "\n",
        "plt.figure(figsize=(12, 6))\n",
        "\n",
        "for column in encoded.columns:\n",
        "    plt.plot(\n",
        "        encoded.index,\n",
        "        encoded[column],\n",
        "        marker=\"o\",\n",
        "        label=column\n",
        "    )\n",
        "\n",
        "plt.title(\"FIND-S Algorithm: Hypothesis Learning\")\n",
        "plt.xlabel(\"Training Examples\")\n",
        "plt.ylabel(\"Encoded Hypothesis Value\")\n",
        "plt.xticks(rotation=30)\n",
        "plt.legend(bbox_to_anchor=(1.05, 1), loc=\"upper left\")\n",
        "plt.grid(True)\n",
        "plt.tight_layout()\n",
        "plt.show()"
