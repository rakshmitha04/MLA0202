        "\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.linear_model import LinearRegression\n",
        "from sklearn.metrics import mean_squared_error, r2_score\n",
        "\n",
        "# Dataset: House area (square feet)\n",
        "X = np.array([[800], [1000], [1200], [1400],\n",
        "              [1600], [1800], [2000], [2200]])\n",
        "\n",
        "# House prices (in lakhs)\n",
        "y = np.array([20, 25, 29, 34, 38, 43, 48, 52])\n",
        "\n",
        "# Create Linear Regression model\n",
        "model = LinearRegression()\n",
        "\n",
        "# Train the model\n",
        "model.fit(X, y)\n",
        "\n",
        "# Predict house prices\n",
        "y_pred = model.predict(X)\n",
        "\n",
        "# Display results\n",
        "print(\"LINEAR REGRESSION\")\n",
        "print(\"------------------------\")\n",
        "print(\"Slope:\", round(model.coef_[0], 4))\n",
        "print(\"Intercept:\", round(model.intercept_, 4))\n",
        "\n",
        "print(\"\\nActual Prices:\", y)\n",
        "print(\"Predicted Prices:\", np.round(y_pred, 2))\n",
        "\n",
        "# Calculate performance\n",
        "mse = mean_squared_error(y, y_pred)\n",
        "r2 = r2_score(y, y_pred)\n",
        "\n",
        "print(\"\\nMean Squared Error:\", round(mse, 2))\n",
        "print(\"R2 Score:\", round(r2, 4))\n",
        "\n",
        "# Predict price for a new house\n",
        "new_area = np.array([[1500]])\n",
        "predicted_price = model.predict(new_area)\n",
        "\n",
        "print(\"\\nPredicted price for 1500 sq.ft house:\",\n",
        "      round(predicted_price[0], 2), \"lakhs\")\n",
        "\n",
        "# Plot the regression line\n",
        "plt.scatter(X, y, color=\"blue\", label=\"Actual Prices\")\n",
        "plt.plot(X, y_pred, color=\"red\", label=\"Regression Line\")\n",
        "\n",
        "plt.xlabel(\"House Area (sq.ft)\")\n",
        "plt.ylabel(\"House Price (Lakhs)\")\n",
        "plt.title(\"Linear Regression - House Price Prediction\")\n",
        "plt.legend()\n",
        "plt.grid(True)\n",
        "plt.show()\n",
        "\n",
        "# Actual vs Predicted graph\n",
        "plt.scatter(y, y_pred, color=\"green\")\n",
        "plt.xlabel(\"Actual Prices\")\n",
        "plt.ylabel(\"Predicted Prices\")\n",
        "plt.title(\"Actual vs Predicted House Prices\")\n",
        "plt.grid(True)\n",
        "plt.show()\n"
      ]
