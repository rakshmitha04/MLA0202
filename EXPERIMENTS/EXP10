        "import matplotlib.pyplot as plt\n",
        "from sklearn.datasets import make_blobs\n",
        "from sklearn.mixture import GaussianMixture\n",
        "\n",
        "# Generate sample data\n",
        "X, _ = make_blobs(\n",
        "    n_samples=300,\n",
        "    centers=3,\n",
        "    cluster_std=1.2,\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "# Fit Gaussian Mixture Model using EM\n",
        "model = GaussianMixture(\n",
        "    n_components=3, random_state=42, n_init=5\n",
        ")\n",
        "model.fit(X)\n",
        "\n",
        "labels = model.predict(X)\n",
        "\n",
        "print(\"EM Algorithm Completed\")\n",
        "print(\"Number of clusters:\", model.n_components)\n",
        "print(\"Converged:\", model.converged_)\n",
        "print(\"Number of iterations:\", model.n_iter_)\n",
        "\n",
        "# Visualize clusters\n",
        "plt.scatter(X[:, 0], X[:, 1], c=labels, cmap=\"viridis\")\n",
        "plt.scatter(\n",
        "    model.means_[:, 0], model.means_[:, 1],\n",
        "    marker=\"X\", s=200, label=\"Cluster Centers\"\n",
        ")\n",
        "plt.title(\"Expectation-Maximization Clustering\")\n",
        "plt.xlabel(\"Feature 1\")\n",
        "plt.ylabel(\"Feature 2\")\n",
        "plt.legend()\n",
        "plt.show()"
      ]
