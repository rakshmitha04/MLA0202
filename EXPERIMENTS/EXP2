      "source": [
        "# Candidate-Elimination Algorithm\n",
        "# Google Colab Ready\n",
        "\n",
        "import pandas as pd\n",
        "\n",
        "# Step 1: Create the dataset\n",
        "data = {\n",
        "    'Sky': ['Sunny', 'Sunny', 'Rainy', 'Sunny'],\n",
        "    'AirTemp': ['Warm', 'Warm', 'Cold', 'Warm'],\n",
        "    'Humidity': ['Normal', 'High', 'High', 'High'],\n",
        "    'Wind': ['Strong', 'Strong', 'Strong', 'Strong'],\n",
        "    'Water': ['Warm', 'Warm', 'Warm', 'Cool'],\n",
        "    'Forecast': ['Same', 'Same', 'Change', 'Change'],\n",
        "    'EnjoySport': ['Yes', 'Yes', 'No', 'Yes']\n",
        "}\n",
        "\n",
        "df = pd.DataFrame(data)\n",
        "\n",
        "print(\"Training Dataset:\")\n",
        "display(df)\n",
        "\n",
        "# Step 2: Initialize S and G boundaries\n",
        "attributes = list(df.columns[:-1])\n",
        "n = len(attributes)\n",
        "\n",
        "S = ['Ø'] * n\n",
        "G = [['?'] * n]\n",
        "\n",
        "# Step 3: Candidate-Elimination algorithm\n",
        "for index, row in df.iterrows():\n",
        "    x = list(row[attributes])\n",
        "    target = row['EnjoySport']\n",
        "\n",
        "    if target == 'Yes':\n",
        "\n",
        "        # Remove inconsistent hypotheses from G\n",
        "        G = [\n",
        "            g for g in G\n",
        "            if all(g[i] == '?' or g[i] == x[i]\n",
        "                   for i in range(n))\n",
        "        ]\n",
        "\n",
        "        # Generalize S\n",
        "        for i in range(n):\n",
        "            if S[i] == 'Ø':\n",
        "                S[i] = x[i]\n",
        "            elif S[i] != x[i]:\n",
        "                S[i] = '?'\n",
        "\n",
        "    else:\n",
        "        # Specialize G for a negative example\n",
        "        new_G = []\n",
        "\n",
        "        for g in G:\n",
        "            if all(g[i] == '?' or g[i] == x[i]\n",
        "                   for i in range(n)):\n",
        "                for i in range(n):\n",
        "                    if g[i] == '?':\n",
        "                        if S[i] != 'Ø' and S[i] != x[i]:\n",
        "                            h = g.copy()\n",
        "                            h[i] = S[i]\n",
        "                            new_G.append(h)\n",
        "            else:\n",
        "                new_G.append(g)\n",
        "\n",
        "        G = new_G\n",
        "\n",
        "    print(f\"\\nExample {index + 1}: {x}, Target: {target}\")\n",
        "    print(\"Specific Boundary S:\", S)\n",
        "    print(\"General Boundary G:\", G)\n",
        "\n",
        "# Step 4: Display final boundaries\n",
        "print(\"\\nFinal Specific Boundary (S):\")\n",
        "display(pd.DataFrame([S], columns=attributes))\n",
        "\n",
        "print(\"\\nFinal General Boundary (G):\")\n",
        "if G:\n",
        "    display(pd.DataFrame(G, columns=attributes))\n",
        "else:\n",
        "    print(\"Empty general boundary\")"
