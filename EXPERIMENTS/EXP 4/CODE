        "\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# STEP 1: Create XOR dataset\n",
        "X = np.array([\n",
        "    [0, 0],\n",
        "    [0, 1],\n",
        "    [1, 0],\n",
        "    [1, 1]\n",
        "])\n",
        "\n",
        "y = np.array([\n",
        "    [0],\n",
        "    [1],\n",
        "    [1],\n",
        "    [0]\n",
        "])\n",
        "\n",
        "# STEP 2: Initialize parameters\n",
        "np.random.seed(42)\n",
        "\n",
        "input_neurons = 2\n",
        "hidden_neurons = 4\n",
        "output_neurons = 1\n",
        "\n",
        "W1 = np.random.randn(input_neurons, hidden_neurons)\n",
        "b1 = np.zeros((1, hidden_neurons))\n",
        "\n",
        "W2 = np.random.randn(hidden_neurons, output_neurons)\n",
        "b2 = np.zeros((1, output_neurons))\n",
        "\n",
        "learning_rate = 0.5\n",
        "epochs = 10000\n",
        "\n",
        "loss_history = []\n",
        "\n",
        "\n",
        "# STEP 3: Sigmoid activation function\n",
        "def sigmoid(x):\n",
        "    return 1 / (1 + np.exp(-np.clip(x, -500, 500)))\n",
        "\n",
        "\n",
        "# STEP 4: Training using Backpropagation\n",
        "for epoch in range(epochs):\n",
        "\n",
        "    # Forward propagation\n",
        "    z1 = np.dot(X, W1) + b1\n",
        "    a1 = sigmoid(z1)\n",
        "\n",
        "    z2 = np.dot(a1, W2) + b2\n",
        "    a2 = sigmoid(z2)\n",
        "\n",
        "    # Calculate error\n",
        "    loss = np.mean((y - a2) ** 2)\n",
        "    loss_history.append(loss)\n",
        "\n",
        "    # Backpropagation\n",
        "    output_error = (a2 - y) * a2 * (1 - a2)\n",
        "\n",
        "    hidden_error = np.dot(\n",
        "        output_error, W2.T\n",
        "    ) * a1 * (1 - a1)\n",
        "\n",
        "    # Update weights and biases\n",
        "    W2 -= learning_rate * np.dot(a1.T, output_error)\n",
        "    b2 -= learning_rate * np.sum(\n",
        "        output_error, axis=0, keepdims=True\n",
        "    )\n",
        "\n",
        "    W1 -= learning_rate * np.dot(X.T, hidden_error)\n",
        "    b1 -= learning_rate * np.sum(\n",
        "        hidden_error, axis=0, keepdims=True\n",
        "    )\n",
        "\n",
        "    # Display training progress\n",
        "    if (epoch + 1) % 2000 == 0:\n",
        "        print(\n",
        "            \"Epoch:\", epoch + 1,\n",
        "            \"Loss:\", round(loss, 6)\n",
        "        )\n",
        "\n",
        "\n",
        "# STEP 5: Prediction\n",
        "z1 = np.dot(X, W1) + b1\n",
        "a1 = sigmoid(z1)\n",
        "\n",
        "z2 = np.dot(a1, W2) + b2\n",
        "predictions = sigmoid(z2)\n",
        "\n",
        "predicted_classes = (predictions >= 0.5).astype(int)\n",
        "\n",
        "accuracy = np.mean(predicted_classes == y) * 100\n",
        "\n",
        "print(\"\\nACTUAL OUTPUT:\")\n",
        "print(y.flatten())\n",
        "\n",
        "print(\"\\nPREDICTED OUTPUT:\")\n",
        "print(predicted_classes.flatten())\n",
        "\n",
        "print(\"\\nACCURACY:\", accuracy, \"%\")\n",
        "\n",
        "\n",
        "# STEP 6: Plot training loss graph\n",
        "plt.figure(figsize=(8, 5))\n",
        "\n",
        "plt.plot(loss_history)\n",
        "\n",
        "plt.title(\"ANN Training Loss using Backpropagation\")\n",
        "plt.xlabel(\"Epochs\")\n",
        "plt.ylabel(\"Mean Squared Error\")\n",
        "plt.grid(True)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# STEP 7: Decision boundary graph\n",
        "xx, yy = np.meshgrid(\n",
        "    np.linspace(-0.2, 1.2, 200),\n",
        "    np.linspace(-0.2, 1.2, 200)\n",
        ")\n",
        "\n",
        "grid = np.c_[xx.ravel(), yy.ravel()]\n",
        "\n",
        "hidden = sigmoid(np.dot(grid, W1) + b1)\n",
        "output = sigmoid(np.dot(hidden, W2) + b2)\n",
        "\n",
        "Z = (output >= 0.5).astype(int)\n",
        "Z = Z.reshape(xx.shape)\n",
        "\n",
        "plt.figure(figsize=(8, 6))\n",
        "\n",
        "plt.contourf(\n",
        "    xx, yy, Z,\n",
        "    levels=[-0.5, 0.5, 1.5],\n",
        "    alpha=0.3\n",
        ")\n",
        "\n",
        "plt.scatter(\n",
        "    X[:, 0], X[:, 1],\n",
        "    c=y.flatten(),\n",
        "    edgecolors='black',\n",
        "    s=150\n",
        ")\n",
        "\n",
        "plt.title(\"ANN Decision Boundary - XOR Dataset\")\n",
        "plt.xlabel(\"Input 1\")\n",
        "plt.ylabel(\"Input 2\")\n",
        "plt.grid(True)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "print(\"\\nBACKPROPAGATION ALGORITHM COMPLETED SUCCESSFULLY\")\n"
      ]
    }
