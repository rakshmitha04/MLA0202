        "\n",
        "import pandas as pd\n",
        "import math\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# STEP 1: Create dataset\n",
        "data = {\n",
        "    'Outlook': [\n",
        "        'Sunny', 'Sunny', 'Overcast', 'Rain',\n",
        "        'Rain', 'Rain', 'Overcast', 'Sunny',\n",
        "        'Sunny', 'Rain', 'Sunny', 'Overcast',\n",
        "        'Overcast', 'Rain'\n",
        "    ],\n",
        "\n",
        "    'Temperature': [\n",
        "        'Hot', 'Hot', 'Hot', 'Mild',\n",
        "        'Cool', 'Cool', 'Cool', 'Mild',\n",
        "        'Cool', 'Mild', 'Mild', 'Mild',\n",
        "        'Hot', 'Mild'\n",
        "    ],\n",
        "\n",
        "    'Humidity': [\n",
        "        'High', 'High', 'High', 'High',\n",
        "        'Normal', 'Normal', 'Normal', 'High',\n",
        "        'Normal', 'Normal', 'Normal', 'High',\n",
        "        'Normal', 'High'\n",
        "    ],\n",
        "\n",
        "    'Wind': [\n",
        "        'Weak', 'Strong', 'Weak', 'Weak',\n",
        "        'Weak', 'Strong', 'Strong', 'Weak',\n",
        "        'Weak', 'Weak', 'Strong', 'Strong',\n",
        "        'Weak', 'Strong'\n",
        "    ],\n",
        "\n",
        "    'PlayTennis': [\n",
        "        'No', 'No', 'Yes', 'Yes',\n",
        "        'Yes', 'No', 'Yes', 'No',\n",
        "        'Yes', 'Yes', 'Yes', 'Yes',\n",
        "        'Yes', 'No'\n",
        "    ]\n",
        "}\n",
        "\n",
        "df = pd.DataFrame(data)\n",
        "\n",
        "print(\"TRAINING DATASET\")\n",
        "print(df.to_string(index=False))\n",
        "\n",
        "\n",
        "# STEP 2: Calculate entropy\n",
        "def entropy(target):\n",
        "\n",
        "    values = target.value_counts(normalize=True)\n",
        "\n",
        "    ent = 0\n",
        "\n",
        "    for p in values:\n",
        "        ent -= p * math.log2(p)\n",
        "\n",
        "    return ent\n",
        "\n",
        "\n",
        "# STEP 3: Calculate information gain\n",
        "def information_gain(dataset, attribute, target):\n",
        "\n",
        "    total_entropy = entropy(dataset[target])\n",
        "\n",
        "    weighted_entropy = 0\n",
        "\n",
        "    for value in dataset[attribute].unique():\n",
        "\n",
        "        subset = dataset[dataset[attribute] == value]\n",
        "\n",
        "        weighted_entropy += (\n",
        "            len(subset) / len(dataset)\n",
        "        ) * entropy(subset[target])\n",
        "\n",
        "    return total_entropy - weighted_entropy\n",
        "\n",
        "\n",
        "# STEP 4: Implement ID3 algorithm\n",
        "def id3(dataset, attributes, target):\n",
        "\n",
        "    # If all examples belong to one class\n",
        "    if len(dataset[target].unique()) == 1:\n",
        "        return dataset[target].iloc[0]\n",
        "\n",
        "    # If no attributes remain\n",
        "    if len(attributes) == 0:\n",
        "        return dataset[target].mode()[0]\n",
        "\n",
        "    # Select best attribute\n",
        "    gains = {\n",
        "        attr: information_gain(dataset, attr, target)\n",
        "        for attr in attributes\n",
        "    }\n",
        "\n",
        "    best_attribute = max(gains, key=gains.get)\n",
        "\n",
        "    print(\"\\nInformation Gain:\")\n",
        "    for attr, gain in gains.items():\n",
        "        print(attr, \":\", round(gain, 4))\n",
        "\n",
        "    print(\"Best Attribute:\", best_attribute)\n",
        "\n",
        "    tree = {best_attribute: {}}\n",
        "\n",
        "    remaining_attributes = [\n",
        "        attr for attr in attributes\n",
        "        if attr != best_attribute\n",
        "    ]\n",
        "\n",
        "    for value in dataset[best_attribute].unique():\n",
        "\n",
        "        subset = dataset[\n",
        "            dataset[best_attribute] == value\n",
        "        ]\n",
        "\n",
        "        tree[best_attribute][value] = id3(\n",
        "            subset,\n",
        "            remaining_attributes,\n",
        "            target\n",
        "        )\n",
        "\n",
        "    return tree\n",
        "\n",
        "\n",
        "# STEP 5: Build decision tree\n",
        "attributes = list(df.columns[:-1])\n",
        "\n",
        "decision_tree = id3(\n",
        "    df,\n",
        "    attributes,\n",
        "    'PlayTennis'\n",
        ")\n",
        "\n",
        "print(\"\\nFINAL DECISION TREE\")\n",
        "print(decision_tree)\n",
        "\n",
        "\n",
        "# STEP 6: Classify a new sample\n",
        "def predict(tree, sample):\n",
        "\n",
        "    if not isinstance(tree, dict):\n",
        "        return tree\n",
        "\n",
        "    attribute = next(iter(tree))\n",
        "    value = sample[attribute]\n",
        "\n",
        "    if value not in tree[attribute]:\n",
        "        return \"Unknown\"\n",
        "\n",
        "    return predict(tree[attribute][value], sample)\n",
        "\n",
        "\n",
        "new_sample = {\n",
        "    'Outlook': 'Sunny',\n",
        "    'Temperature': 'Cool',\n",
        "    'Humidity': 'High',\n",
        "    'Wind': 'Strong'\n",
        "}\n",
        "\n",
        "result = predict(decision_tree, new_sample)\n",
        "\n",
        "print(\"\\nNEW SAMPLE\")\n",
        "print(new_sample)\n",
        "\n",
        "print(\"PREDICTED CLASS:\", result)\n",
        "\n",
        "\n",
        "# STEP 7: Draw decision tree graph\n",
        "def count_leaves(tree):\n",
        "\n",
        "    if not isinstance(tree, dict):\n",
        "        return 1\n",
        "\n",
        "    return sum(\n",
        "        count_leaves(child)\n",
        "        for child in next(iter(tree.values())).values()\n",
        "    )\n",
        "\n",
        "\n",
        "def draw_tree(ax, tree, x, y, width, level=0):\n",
        "\n",
        "    if not isinstance(tree, dict):\n",
        "        ax.text(\n",
        "            x, y, str(tree),\n",
        "            ha='center', va='center',\n",
        "            fontsize=11,\n",
        "            bbox=dict(\n",
        "                boxstyle='round',\n",
        "                facecolor='lightgreen',\n",
        "                edgecolor='black'\n",
        "            )\n",
        "        )\n",
        "        return\n",
        "\n",
        "    attribute = next(iter(tree))\n",
        "\n",
        "    ax.text(\n",
        "        x, y, attribute,\n",
        "        ha='center', va='center',\n",
        "        fontsize=11,\n",
        "        bbox=dict(\n",
        "            boxstyle='round',\n",
        "            facecolor='skyblue',\n",
        "            edgecolor='black'\n",
        "        )\n",
        "    )\n",
        "\n",
        "    branches = tree[attribute]\n",
        "    total_leaves = count_leaves(tree)\n",
        "\n",
        "    current_x = x - width / 2\n",
        "\n",
        "    for value, child in branches.items():\n",
        "\n",
        "        child_leaves = count_leaves(child)\n",
        "\n",
        "        child_width = (\n",
        "            width * child_leaves / total_leaves\n",
        "        )\n",
        "\n",
        "        child_x = current_x + child_width / 2\n",
        "        child_y = y - 1.5\n",
        "\n",
        "        ax.plot(\n",
        "            [x, child_x],\n",
        "            [y - 0.15, child_y + 0.15],\n",
        "            color='black'\n",
        "        )\n",
        "\n",
        "        ax.text(\n",
        "            (x + child_x) / 2,\n",
        "            (y + child_y) / 2,\n",
        "            str(value),\n",
        "            fontsize=9,\n",
        "            ha='center',\n",
        "            backgroundcolor='white'\n",
        "        )\n",
        "\n",
        "        draw_tree(\n",
        "            ax, child,\n",
        "            child_x, child_y,\n",
        "            child_width,\n",
        "            level + 1\n",
        "        )\n",
        "\n",
        "        current_x += child_width\n",
        "\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(14, 9))\n",
        "\n",
        "draw_tree(\n",
        "    ax,\n",
        "    decision_tree,\n",
        "    0, 0,\n",
        "    12\n",
        ")\n",
        "\n",
        "ax.set_title(\n",
        "    \"Decision Tree using ID3 Algorithm\",\n",
        "    fontsize=16\n",
        ")\n",
        "\n",
        "ax.axis('off')\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "print(\"\\nID3 ALGORITHM COMPLETED SUCCESSFULLY\")\n"
      ]
    }
